@@ -0,0 +1,78 @@
+#pragma once
+
+// Internal Linux hybrid-CPU detection. Probe is a compile-time seam for native
+// topology tests; production always uses the Linux/CPUID implementation.
+#include <algorithm>
+#include <cstdint>
+#include <sched.h>
+#include <string>
+#include <unordered_set>
+
+template <typename Probe>
+class common_cpu_affinity_guard {
+public:
+    common_cpu_affinity_guard(Probe & probe, const cpu_set_t & affinity) : probe(probe), affinity(affinity) {} // 保存待恢复的亲和性。
+    common_cpu_affinity_guard(const common_cpu_affinity_guard &) = delete; // 禁止复制守卫。
+    common_cpu_affinity_guard & operator=(const common_cpu_affinity_guard &) = delete; // 禁止转移恢复责任。
+
+    ~common_cpu_affinity_guard() { // 异常退出或首次恢复失败时兜底恢复亲和性。
+        if (!restored) {
+            probe.set_affinity(affinity);
+        }
+    }
+
+    bool restore() { // 显式恢复并记录结果，失败时由析构再试一次。
+        restored = probe.set_affinity(affinity);
+        return restored;
+    }
+
+private:
+    Probe & probe;
+    cpu_set_t affinity;
+    bool restored = false;
+};
+
+template <typename Probe>
+int32_t common_cpu_count_hybrid(Probe & probe) { // 按 SMT 拓扑去重 P 核，失败时使用受限回退值。
+    cpu_set_t affinity;
+    if (!probe.get_affinity(affinity)) {
+        return probe.physical_cores();
+    }
+    const int available = CPU_COUNT(&affinity);
+    if (available == 0) {
+        return probe.physical_cores();
+    }
+
+    common_cpu_affinity_guard<Probe> restore_affinity(probe, affinity);
+    std::unordered_set<std::string> siblings_seen;
+    bool complete = true;
+    // CPU IDs need not be contiguous or smaller than the online CPU count.
+    for (int cpu = 0; cpu < CPU_SETSIZE; ++cpu) {
+        if (!CPU_ISSET(cpu, &affinity)) {
+            continue;
+        }
+        if (!probe.pin_cpu(cpu)) {
+            complete = false;
+            break;
+        }
+        if (probe.is_efficiency_core()) {
+            continue;
+        }
+        std::string siblings;
+        if (!probe.thread_siblings(cpu, siblings) || siblings.empty()) {
+            complete = false;
+            break;
+        }
+        // A physical P core counts once, with or without SMT and regardless
+        // of how the kernel numbers its logical CPUs.
+        siblings_seen.insert(siblings);
+    }
+    if (!restore_affinity.restore()) {
+        complete = false;
+    }
+    if (complete && !siblings_seen.empty()) {
+        return static_cast<int32_t>(siblings_seen.size());
+    }
+    // Keep the existing physical-core fallback, bounded by the original mask.
+    return std::max(1, std::min(probe.physical_cores(), available));
+}
